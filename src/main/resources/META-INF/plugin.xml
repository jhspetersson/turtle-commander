<idea-plugin require-restart="false">
    <id>io.github.jhspetersson.turtlecommander</id>
    <name>Turtle Commander</name>
    <vendor>jhspetersson@gmail.com</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="terminal-integration.xml">org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="io.github.jhspetersson.turtlecommander.ui.FileManagerToolWindowFactory"
            id="Turtle Commander"
            anchor="bottom"
            icon="/icons/turtleCommander.svg"
        />
        <fileType
            name="Turtle Commander Theme"
            implementationClass="io.github.jhspetersson.turtlecommander.filetype.TctThemeFileType"
            fieldName="INSTANCE"
            extensions="tctheme"
        />
        <editorNotificationProvider
            implementation="io.github.jhspetersson.turtlecommander.filetype.TctThemeEditorNotificationProvider"
        />
        <notificationGroup
            id="Turtle Commander"
            displayType="BALLOON"
        />
        <applicationConfigurable
            parentId="tools"
            instance="io.github.jhspetersson.turtlecommander.settings.TurtleCommanderConfigurable"
            id="io.github.jhspetersson.turtlecommander.settings"
            displayName="Turtle Commander"
        />
    </extensions>

    <projectListeners>
        <listener
            class="io.github.jhspetersson.turtlecommander.vfs.VfsEditFileListener"
            topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"
        />
    </projectListeners>

    <actions>
        <group id="TurtleCommander.Actions" text="Turtle Commander" popup="false">
            <action id="TurtleCommander.OpenEntry"
                    class="io.github.jhspetersson.turtlecommander.action.OpenEntryAction"
                    text="Open Entry"
                    description="Open selected file or directory">
                <keyboard-shortcut first-keystroke="ENTER" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ViewFile"
                    class="io.github.jhspetersson.turtlecommander.action.ViewFileAction"
                    text="View File"
                    description="Open selected file in editor">
                <keyboard-shortcut first-keystroke="F3" keymap="$default"/>
            </action>
            <action id="TurtleCommander.OpenInApp"
                    class="io.github.jhspetersson.turtlecommander.action.OpenInAppAction"
                    text="Open in Associated Application"
                    description="Open file with system default application">
                <keyboard-shortcut first-keystroke="F4" keymap="$default"/>
            </action>
            <action id="TurtleCommander.GoUp"
                    class="io.github.jhspetersson.turtlecommander.action.GoUpAction"
                    text="Go Up"
                    description="Navigate to parent directory">
                <keyboard-shortcut first-keystroke="BACK_SPACE" keymap="$default"/>
            </action>
            <action id="TurtleCommander.BackToRoot"
                    class="io.github.jhspetersson.turtlecommander.action.BackToRootAction"
                    text="Back to Root"
                    description="Navigate to the root of the current filesystem or archive">
                <keyboard-shortcut first-keystroke="ctrl BACK_SLASH" keymap="$default"/>
            </action>
            <action id="TurtleCommander.Rename"
                    class="io.github.jhspetersson.turtlecommander.action.RenameAction"
                    text="Rename"
                    description="Rename selected file or directory">
                <keyboard-shortcut first-keystroke="shift F6" keymap="$default"/>
            </action>
            <action id="TurtleCommander.MultiRename"
                    class="io.github.jhspetersson.turtlecommander.action.MultiRenameAction"
                    text="Multi-Rename..."
                    description="Batch-rename selected files with a template (Ctrl+M)">
                <keyboard-shortcut first-keystroke="ctrl M" keymap="$default"/>
            </action>
            <action id="TurtleCommander.MultiRenameUndo"
                    class="io.github.jhspetersson.turtlecommander.action.MultiRenameUndoAction"
                    text="Undo Multi-Rename"
                    description="Reverse the last multi-rename batch">
                <keyboard-shortcut first-keystroke="ctrl shift M" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CopyFiles"
                    class="io.github.jhspetersson.turtlecommander.action.CopyFilesAction"
                    text="Copy Files"
                    description="Copy selected files to the other panel">
                <keyboard-shortcut first-keystroke="F5" keymap="$default"/>
            </action>
            <action id="TurtleCommander.MoveFiles"
                    class="io.github.jhspetersson.turtlecommander.action.MoveFilesAction"
                    text="Move Files"
                    description="Move selected files to the other panel">
                <keyboard-shortcut first-keystroke="F6" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CreateDirectory"
                    class="io.github.jhspetersson.turtlecommander.action.CreateDirectoryAction"
                    text="Create Directory"
                    description="Create a new directory">
                <keyboard-shortcut first-keystroke="F7" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CreateFile"
                    class="io.github.jhspetersson.turtlecommander.action.CreateFileAction"
                    text="Create File"
                    description="Create a new file and open it in editor">
                <keyboard-shortcut first-keystroke="shift F4" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CreateLink"
                    class="io.github.jhspetersson.turtlecommander.action.CreateLinkAction"
                    text="Create Link"
                    description="Create symbolic or hard links to the selection in the other panel">
                <keyboard-shortcut first-keystroke="alt F6" keymap="$default"/>
            </action>
            <action id="TurtleCommander.DeleteFiles"
                    class="io.github.jhspetersson.turtlecommander.action.DeleteFilesAction"
                    text="Delete Files"
                    description="Delete selected files">
                <keyboard-shortcut first-keystroke="F8" keymap="$default"/>
                <keyboard-shortcut first-keystroke="DELETE" keymap="$default"/>
                <keyboard-shortcut first-keystroke="shift DELETE" keymap="$default"/>
                <keyboard-shortcut first-keystroke="shift F8" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SwitchPanel"
                    class="io.github.jhspetersson.turtlecommander.action.SwitchPanelAction"
                    text="Switch Panel"
                    description="Switch focus between left and right panels">
                <keyboard-shortcut first-keystroke="TAB" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ExecuteCommand"
                    class="io.github.jhspetersson.turtlecommander.action.ExecuteCommandAction"
                    text="Execute Command"
                    description="Show the command line below the panels to run a shell command in the active panel's directory">
                <keyboard-shortcut first-keystroke="ctrl E" keymap="$default"/>
            </action>
            <action id="TurtleCommander.GoToFirst"
                    class="io.github.jhspetersson.turtlecommander.action.GoToFirstAction"
                    text="Go to First"
                    description="Select the first entry in the file list">
                <keyboard-shortcut first-keystroke="HOME" keymap="$default"/>
            </action>
            <action id="TurtleCommander.GoToLast"
                    class="io.github.jhspetersson.turtlecommander.action.GoToLastAction"
                    text="Go to Last"
                    description="Select the last entry in the file list">
                <keyboard-shortcut first-keystroke="END" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ToggleSelection"
                    class="io.github.jhspetersson.turtlecommander.action.ToggleSelectionAction"
                    text="Toggle Selection"
                    description="Toggle selection of the current entry without moving the cursor">
                <keyboard-shortcut first-keystroke="SPACE" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ToggleSelectionMark"
                    class="io.github.jhspetersson.turtlecommander.action.ToggleSelectionMarkAction"
                    text="Toggle Selection (Move Cursor Down)"
                    description="Toggle selection of the current entry and move to the next one">
                <keyboard-shortcut first-keystroke="INSERT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SelectAll"
                    class="io.github.jhspetersson.turtlecommander.action.SelectAllAction"
                    text="Select All"
                    description="Mark every entry in the current view">
                <keyboard-shortcut first-keystroke="ctrl ADD" keymap="$default"/>
                <keyboard-shortcut first-keystroke="ctrl A" keymap="$default"/>
            </action>
            <action id="TurtleCommander.UnselectAll"
                    class="io.github.jhspetersson.turtlecommander.action.UnselectAllAction"
                    text="Unselect All"
                    description="Clear all marks in the current view">
                <keyboard-shortcut first-keystroke="ctrl SUBTRACT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.InvertSelection"
                    class="io.github.jhspetersson.turtlecommander.action.InvertSelectionAction"
                    text="Invert Selection"
                    description="Flip marks for every entry in the current view">
                <keyboard-shortcut first-keystroke="MULTIPLY" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SelectByPattern"
                    class="io.github.jhspetersson.turtlecommander.action.SelectByPatternAction"
                    text="Select by Pattern..."
                    description="Mark files matching a wildcard mask (e.g. *.txt)">
                <keyboard-shortcut first-keystroke="ADD" keymap="$default"/>
            </action>
            <action id="TurtleCommander.UnselectByPattern"
                    class="io.github.jhspetersson.turtlecommander.action.UnselectByPatternAction"
                    text="Unselect by Pattern..."
                    description="Unmark files matching a wildcard mask (e.g. *.txt)">
                <keyboard-shortcut first-keystroke="SUBTRACT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SelectSameExtension"
                    class="io.github.jhspetersson.turtlecommander.action.SelectSameExtensionAction"
                    text="Select Same Extension"
                    description="Mark all files sharing the focused entry's extension">
                <keyboard-shortcut first-keystroke="alt ADD" keymap="$default"/>
            </action>
            <action id="TurtleCommander.UnselectSameExtension"
                    class="io.github.jhspetersson.turtlecommander.action.UnselectSameExtensionAction"
                    text="Unselect Same Extension"
                    description="Unmark all files sharing the focused entry's extension">
                <keyboard-shortcut first-keystroke="alt SUBTRACT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SaveSelection"
                    class="io.github.jhspetersson.turtlecommander.action.SaveSelectionAction"
                    text="Save Selection"
                    description="Remember the current marks so they can be restored later">
                <keyboard-shortcut first-keystroke="ctrl MULTIPLY" keymap="$default"/>
            </action>
            <action id="TurtleCommander.RestoreSelection"
                    class="io.github.jhspetersson.turtlecommander.action.RestoreSelectionAction"
                    text="Restore Selection"
                    description="Restore the marks captured by Save Selection">
                <keyboard-shortcut first-keystroke="DIVIDE" keymap="$default"/>
            </action>
            <action id="TurtleCommander.Quit"
                    class="io.github.jhspetersson.turtlecommander.action.QuitAction"
                    text="Quit"
                    description="Close the Turtle Commander tool window">
                <keyboard-shortcut first-keystroke="F10" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ShowContextMenu"
                    class="io.github.jhspetersson.turtlecommander.action.ShowContextMenuAction"
                    text="Show Context Menu"
                    description="Show context menu for the selected entry">
                <keyboard-shortcut first-keystroke="CONTEXT_MENU" keymap="$default"/>
                <keyboard-shortcut first-keystroke="shift F10" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SearchFiles"
                    class="io.github.jhspetersson.turtlecommander.action.SearchFilesAction"
                    text="Search Files"
                    description="Search for files in the current directory">
                <keyboard-shortcut first-keystroke="alt F7" keymap="$default"/>
            </action>
            <action id="TurtleCommander.SearchInDirectory"
                    class="io.github.jhspetersson.turtlecommander.action.ContextSearchInDirectoryAction"
                    text="Search in Directory..."
                    icon="AllIcons.Actions.Find"
                    description="Search for files in the selected directory"/>
            <action id="TurtleCommander.QuickFilter"
                    class="io.github.jhspetersson.turtlecommander.action.QuickFilterAction"
                    text="Quick Filter"
                    description="Filter files in the current directory">
                <keyboard-shortcut first-keystroke="ctrl S" keymap="$default"/>
            </action>
            <action id="TurtleCommander.Refresh"
                    class="io.github.jhspetersson.turtlecommander.action.RefreshAction"
                    text="Refresh"
                    description="Refresh the current directory listing">
                <keyboard-shortcut first-keystroke="ctrl R" keymap="$default"/>
            </action>
            <action id="TurtleCommander.LeftDriveSelector"
                    class="io.github.jhspetersson.turtlecommander.action.LeftDriveSelectorAction"
                    text="Left Panel Drive Selector"
                    description="Show drive selector for the left panel">
                <keyboard-shortcut first-keystroke="alt F1" keymap="$default"/>
            </action>
            <action id="TurtleCommander.RightDriveSelector"
                    class="io.github.jhspetersson.turtlecommander.action.RightDriveSelectorAction"
                    text="Right Panel Drive Selector"
                    description="Show drive selector for the right panel">
                <keyboard-shortcut first-keystroke="alt F2" keymap="$default"/>
            </action>
            <action id="TurtleCommander.NewTab"
                    class="io.github.jhspetersson.turtlecommander.action.NewTabAction"
                    text="New Tab"
                    description="Open a new tab in the active panel">
                <keyboard-shortcut first-keystroke="ctrl T" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ReopenTab"
                    class="io.github.jhspetersson.turtlecommander.action.ReopenTabAction"
                    text="Reopen Closed Tab"
                    description="Reopen the last tab closed in the active panel">
                <keyboard-shortcut first-keystroke="ctrl shift T" keymap="$default"/>
            </action>
            <action id="TurtleCommander.NextTab"
                    class="io.github.jhspetersson.turtlecommander.action.NextTabAction"
                    text="Next Tab"
                    description="Switch to the next tab in the active panel">
                <keyboard-shortcut first-keystroke="alt RIGHT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.PreviousTab"
                    class="io.github.jhspetersson.turtlecommander.action.PreviousTabAction"
                    text="Previous Tab"
                    description="Switch to the previous tab in the active panel">
                <keyboard-shortcut first-keystroke="alt LEFT" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CloseTab"
                    class="io.github.jhspetersson.turtlecommander.action.CloseTabAction"
                    text="Close"
                    description="Close the selected tab">
                <keyboard-shortcut first-keystroke="ctrl W" keymap="$default"/>
            </action>
            <action id="TurtleCommander.CloseOtherTabs"
                    class="io.github.jhspetersson.turtlecommander.action.CloseOtherTabsAction"
                    text="Close Other Tabs"
                    description="Close all tabs except the selected one"/>
            <action id="TurtleCommander.CloseAllTabs"
                    class="io.github.jhspetersson.turtlecommander.action.CloseAllTabsAction"
                    text="Close All Tabs"
                    description="Close all tabs except one"/>
            <action id="TurtleCommander.CloseDuplicateTabs"
                    class="io.github.jhspetersson.turtlecommander.action.CloseDuplicateTabsAction"
                    text="Close Duplicate Tabs"
                    description="Close other tabs with the same path as the selected tab"/>
            <action id="TurtleCommander.DuplicateTab"
                    class="io.github.jhspetersson.turtlecommander.action.DuplicateTabAction"
                    text="Duplicate Tab"
                    description="Open a new tab with the same path and view as the selected tab"/>
            <action id="TurtleCommander.CloseTabsToTheLeft"
                    class="io.github.jhspetersson.turtlecommander.action.CloseTabsToTheLeftAction"
                    text="Close Tabs to the Left"
                    description="Close all tabs to the left of the selected tab"/>
            <action id="TurtleCommander.CloseTabsToTheRight"
                    class="io.github.jhspetersson.turtlecommander.action.CloseTabsToTheRightAction"
                    text="Close Tabs to the Right"
                    description="Close all tabs to the right of the selected tab"/>
            <action id="TurtleCommander.OpenInNewTab"
                    class="io.github.jhspetersson.turtlecommander.action.OpenInNewTabAction"
                    text="Open in New Tab"
                    icon="AllIcons.Actions.OpenNewTab"
                    description="Open directory in a new tab"/>
            <action id="TurtleCommander.OpenFile"
                    class="io.github.jhspetersson.turtlecommander.action.OpenFileAction"
                    text="Open"
                    icon="AllIcons.Actions.MenuOpen"
                    description="Open file in editor"/>
            <action id="TurtleCommander.OpenInAssociatedApp"
                    class="io.github.jhspetersson.turtlecommander.action.OpenInAssociatedAppAction"
                    text="Open in Associated Application"
                    icon="AllIcons.Actions.Execute"
                    description="Open file with system default application"/>
            <action id="TurtleCommander.OpenInExplorer"
                    class="io.github.jhspetersson.turtlecommander.action.OpenInExplorerAction"
                    text="Open in Explorer"
                    description="Open in system file manager"/>
            <action id="TurtleCommander.ShowProperties"
                    class="io.github.jhspetersson.turtlecommander.action.ShowPropertiesAction"
                    text="Properties"
                    icon="AllIcons.Actions.Properties"
                    description="Show the system Properties / Get Info dialog (or a built-in fallback on unknown desktops)"/>
            <action id="TurtleCommander.ContextCopy"
                    class="io.github.jhspetersson.turtlecommander.action.ContextCopyAction"
                    text="Copy"
                    icon="AllIcons.Actions.Copy"
                    description="Copy selected files to buffer">
                <keyboard-shortcut first-keystroke="ctrl C" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ContextCut"
                    class="io.github.jhspetersson.turtlecommander.action.ContextCutAction"
                    text="Cut"
                    icon="AllIcons.Actions.MenuCut"
                    description="Cut selected files to buffer">
                <keyboard-shortcut first-keystroke="ctrl X" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ContextPaste"
                    class="io.github.jhspetersson.turtlecommander.action.ContextPasteAction"
                    text="Paste"
                    icon="AllIcons.Actions.MenuPaste"
                    description="Paste files from buffer into current directory">
                <keyboard-shortcut first-keystroke="ctrl V" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ContextPasteInto"
                    class="io.github.jhspetersson.turtlecommander.action.ContextPasteIntoAction"
                    text="Paste Into"
                    icon="AllIcons.Actions.MenuPaste"
                    description="Paste files from buffer into selected directory"/>
            <action id="TurtleCommander.ContextRename"
                    class="io.github.jhspetersson.turtlecommander.action.ContextRenameAction"
                    text="Rename"
                    icon="AllIcons.Actions.Edit"
                    description="Rename selected file or directory"/>
            <action id="TurtleCommander.ContextCreateLink"
                    class="io.github.jhspetersson.turtlecommander.action.ContextCreateLinkAction"
                    text="Create Link..."
                    description="Create symbolic or hard links to the selection in the other panel"/>
            <action id="TurtleCommander.ContextDelete"
                    class="io.github.jhspetersson.turtlecommander.action.ContextDeleteAction"
                    text="Delete"
                    icon="AllIcons.Actions.GC"
                    description="Delete selected files"/>
            <action id="TurtleCommander.ContextMultiRename"
                    class="io.github.jhspetersson.turtlecommander.action.ContextMultiRenameAction"
                    text="Multi-Rename..."
                    icon="AllIcons.Actions.Edit"
                    description="Batch-rename selected files with a template"/>
            <action id="TurtleCommander.PackFiles"
                    class="io.github.jhspetersson.turtlecommander.action.PackFilesAction"
                    text="Pack Files"
                    icon="AllIcons.FileTypes.Archive"
                    description="Pack selected files into a zip archive">
                <keyboard-shortcut first-keystroke="shift F1" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ExtractFiles"
                    class="io.github.jhspetersson.turtlecommander.action.ExtractFilesAction"
                    text="Extract Files..."
                    icon="AllIcons.Actions.Uninstall"
                    description="Extract archive to a directory">
                <keyboard-shortcut first-keystroke="shift F2" keymap="$default"/>
            </action>
            <action id="TurtleCommander.ExtractHere"
                    class="io.github.jhspetersson.turtlecommander.action.ExtractHereAction"
                    text="Extract Here"
                    icon="AllIcons.Actions.Uninstall"
                    description="Extract archive into current directory"/>
            <action id="TurtleCommander.ExtractToSubdir"
                    class="io.github.jhspetersson.turtlecommander.action.ExtractToSubdirAction"
                    text="Extract to Subdir..."
                    icon="AllIcons.Actions.Uninstall"
                    description="Extract archive into a subdirectory named after the archive"/>
            <action id="TurtleCommander.SplitFile"
                    class="io.github.jhspetersson.turtlecommander.action.SplitFileAction"
                    text="Split File..."
                    icon="AllIcons.Actions.SplitHorizontally"
                    description="Split file into smaller parts"/>
            <action id="TurtleCommander.CombineFiles"
                    class="io.github.jhspetersson.turtlecommander.action.CombineFilesAction"
                    text="Combine Files..."
                    icon="AllIcons.Actions.Collapseall"
                    description="Combine split file parts back into original file"/>
            <action id="TurtleCommander.AddToFavorites"
                    class="io.github.jhspetersson.turtlecommander.action.AddToFavoritesAction"
                    text="Add to Favorites"
                    icon="AllIcons.Nodes.Favorite"
                    description="Add directory to favorites"/>
            <action id="TurtleCommander.CompareFiles"
                    class="io.github.jhspetersson.turtlecommander.action.CompareFilesAction"
                    text="Compare Files"
                    icon="AllIcons.Actions.Diff"
                    description="Compare two files"/>
            <action id="TurtleCommander.QuickAccess.1" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 1">
                <keyboard-shortcut first-keystroke="ctrl 1" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.2" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 2">
                <keyboard-shortcut first-keystroke="ctrl 2" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.3" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 3">
                <keyboard-shortcut first-keystroke="ctrl 3" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.4" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 4">
                <keyboard-shortcut first-keystroke="ctrl 4" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.5" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 5">
                <keyboard-shortcut first-keystroke="ctrl 5" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.6" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 6">
                <keyboard-shortcut first-keystroke="ctrl 6" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.7" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 7">
                <keyboard-shortcut first-keystroke="ctrl 7" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.8" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 8">
                <keyboard-shortcut first-keystroke="ctrl 8" keymap="$default"/>
            </action>
            <action id="TurtleCommander.QuickAccess.9" class="io.github.jhspetersson.turtlecommander.action.QuickAccessFavoriteAction" text="Favorite 9">
                <keyboard-shortcut first-keystroke="ctrl 9" keymap="$default"/>
            </action>
        </group>
        <!-- Copy as submenu actions (file context menu) -->
        <action id="TurtleCommander.CopyAsName"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsNameAction"
                text="Filename"/>
        <action id="TurtleCommander.CopyAsFullPath"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsFullPathAction"
                text="Full Path"/>
        <action id="TurtleCommander.CopyAsParentPath"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsParentPathAction"
                text="Parent Path"/>
        <action id="TurtleCommander.CopyAsCrc16"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsCrc16Action"
                text="CRC16"/>
        <action id="TurtleCommander.CopyAsCrc32"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsCrc32Action"
                text="CRC32"/>
        <action id="TurtleCommander.CopyAsMd5"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsMd5Action"
                text="MD5"/>
        <action id="TurtleCommander.CopyAsSha1"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsSha1Action"
                text="SHA-1"/>
        <action id="TurtleCommander.CopyAsSha256"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsSha256Action"
                text="SHA-256"/>
        <action id="TurtleCommander.CopyAsSha512"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsSha512Action"
                text="SHA-512"/>
        <action id="TurtleCommander.CopyAsSha3_256"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsSha3_256Action"
                text="SHA3-256"/>
        <action id="TurtleCommander.CopyAsSha3_512"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsSha3_512Action"
                text="SHA3-512"/>
        <action id="TurtleCommander.CopyAsCsv"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsCsvAction"
                text="CSV"
                description="Copy selected entries as CSV (filename, path, plus the configured columns)"/>
        <action id="TurtleCommander.CopyAsJson"
                class="io.github.jhspetersson.turtlecommander.action.CopyAsJsonAction"
                text="JSON"
